NODE_ENV=development
PORT=3000
DB_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:3000

# Optional Cloudinary upload integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Resend password-reset email integration
RESEND_API_KEY=
MAIL_FROM="Rental Management <onboarding@example.com>"
# resend, mailtrap, or gmail
MAIL_PROVIDER=resend
RESET_PASSWORD_URL=http://localhost:3001/reset-password
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# H-05/OTP: pepper riêng cho HMAC của mã OTP (>= 32 ký tự).
# KHÔNG dùng lại JWT_SECRET/DB_URL. Gợi ý sinh giá trị: openssl rand -base64 48
OTP_PEPPER=
# Tăng số này khi xoay pepper mới (mọi OTP đang sống trở nên không dùng được).
OTP_PEPPER_VERSION=1
