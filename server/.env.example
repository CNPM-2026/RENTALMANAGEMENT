NODE_ENV=development
PORT=3000
DB_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Optional Cloudinary upload integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Resend password-reset email integration
RESEND_API_KEY=
MAIL_FROM="Rental Management <onboarding@example.com>"
MAIL_PROVIDER=resend
RESET_PASSWORD_URL=http://localhost:3000/reset-password
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rental Management <no-reply@example.test>"