// datasource và generator cấu hình kết nối PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (Các kiểu dữ liệu cố định)
// ==========================================

enum Role {
  ADMIN
  LANDLORD
  TENANT
  // 🆕 STAFF: thợ / nhà cung cấp dịch vụ ĐỘC LẬP (marketplace).
  // KHÔNG phải nhân viên của chủ trọ — đó là `StaffMembership` (bảng riêng).
  // Tài khoản STAFF tự đăng ký, tự quản lý hồ sơ, làm việc với nhiều chủ trọ.
  STAFF
  // ⚠️ DEPRECATED: AGENT không còn được cấp cho tài khoản mới và không còn
  // route/middleware/UI nào xử lý role này. Giá trị enum chỉ còn tồn tại để
  // KHÔNG làm hỏng các row `users.role = 'AGENT'` đang có trong DB.
  // Việc xoá hẳn giá trị này là một migration có mất dữ liệu (xem
  // docs/BATCH-1-STAFF-FOUNDATION.md §5) và phải được duyệt riêng.
  AGENT // Người dẫn đi xem / Môi giới / Cộng tác viên
}

// 🆕 Nhóm kỹ năng / loại dịch vụ của thợ (structured data, không phải text tự do)
