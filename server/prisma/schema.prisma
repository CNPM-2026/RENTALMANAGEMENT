  ELECTRICAL // Sửa điện
  PLUMBING // Sửa ống nước
  WATER_LEAK // Xử lý rò rỉ nước
  FURNITURE // Sửa chữa nội thất
  AIR_CONDITIONER // Bảo trì máy lạnh
  PAINTING // Sơn sửa
  CLEANING // Vệ sinh
  GENERAL_MAINTENANCE // Bảo trì tổng hợp
}

enum RoomStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum PostType {
  RENT_OUT // Cho thuê phòng
  FIND_ROOM // Tìm phòng
  FIND_ROOMMATE // Tìm bạn ở ghép
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
