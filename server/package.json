{
  "name": "rental-management-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:sync": "prisma db push --skip-generate",
    "db:seed": "node -e \"require('dotenv').config({path:'.env'}); process.env.NODE_ENV='development'; require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['ts-node','prisma/seed.ts'],{stdio:'inherit',env:process.env,shell:true})\"",
    "db:test:init": "node scripts/init-test-db.js",
    "db:test:seed": "node -e \"require('dotenv').config({path:'.env.test'}); process.env.NODE_ENV='test'; require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['ts-node','prisma/seed.ts'],{stdio:'inherit',env:process.env,shell:true})\"",
    "evidence:inventory": "node scripts/maintenance-evidence-migration.js inventory",
    "evidence:migrate": "node scripts/maintenance-evidence-migration.js migrate --confirm",
    "evidence:verify": "node scripts/maintenance-evidence-migration.js verify",
    "evidence:selftest": "node scripts/maintenance-evidence-migration.js selftest",
    "db:index:one-active-task": "node scripts/apply-maintenance-task-index.js --confirm",
    "db:index:one-active-task:preflight": "node scripts/apply-maintenance-task-index.js",
    "db:batch3:lifecycle": "node scripts/apply-batch3-lifecycle.js --confirm",
    "db:batch3:lifecycle:preflight": "node scripts/apply-batch3-lifecycle.js",
    "db:platform:delta": "node scripts/apply-platform-delta.js --confirm",
    "db:platform:delta:preflight": "node scripts/apply-platform-delta.js",
    "db:occupancy:delta": "node scripts/apply-occupancy-invoice-delta.js --confirm",
    "db:occupancy:delta:preflight": "node scripts/apply-occupancy-invoice-delta.js",
    "db:contract-lifecycle": "prisma db execute --file prisma/sql/contract-lifecycle-delta.sql --schema prisma/schema.prisma",
    "db:invoice:fees": "prisma db execute --file prisma/sql/invoice-room-fees-delta.sql --schema prisma/schema.prisma",
    "db:occupancy:seed:dev": "node scripts/seed-dev-occupancy.js --confirm",
    "db:occupancy:seed:dev:preflight": "node scripts/seed-dev-occupancy.js",
    "db:demand:reconcile": "node scripts/reconcile-room-demand.js --confirm",
    "db:demand:reconcile:preflight": "node scripts/reconcile-room-demand.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.21",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-types": "^12.1.3",
    "resend": "^6.35.0",
    "supertest": "^7.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "swagger-jsdoc": {
      "glob": "14.0.3"
    }
  }
}
