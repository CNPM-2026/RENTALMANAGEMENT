{
  "name": "rental-management-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "node -e \"require('dotenv').config({path:'.env'}); process.env.NODE_ENV='development'; require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['ts-node','prisma/seed.ts'],{stdio:'inherit',env:process.env,shell:true})\"",
    "db:test:init": "node scripts/init-test-db.js",
    "db:test:seed": "node -e \"require('dotenv').config({path:'.env.test'}); process.env.NODE_ENV='test'; require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['ts-node','prisma/seed.ts'],{stdio:'inherit',env:process.env,shell:true})\"",
    "test": "node scripts/run-tests.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/socket.io": "^3.0.1",
    "prisma": "^6.0.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
